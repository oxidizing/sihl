# Copy this file to .env and fill in values.
# NEVER commit .env — it contains secrets.

### GIT ###
# GitHub token used for git operations inside the container (replaces the ~/.ssh host mount)
# Use a fine-grained token for uzh/sihl with "Contents: Read and write".
GIT_REMOTE_USERNAME=
GIT_REMOTE_PAT=

# Git identity inside the container (replaces the ~/.gitconfig host mount)
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
